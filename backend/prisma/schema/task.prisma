model Task {
    id          String       @id @default(uuid())
    columnId    String
    title       String
    description String?
    position    Float
    priority    TaskPriority @default(MEDIUM)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    column    Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)

    @@index([columnId])
}
